#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OMARCHY_SHELL_ROOT=${OMARCHY_SHELL_ROOT:-/usr/share/omarchy/shell}
QML_IMPORT_MIRROR=""
VALIDATION_ROOT=""

cleanup() {
  [[ -z $QML_IMPORT_MIRROR ]] || rm -rf -- "$QML_IMPORT_MIRROR"
  [[ -z $VALIDATION_ROOT ]] || rm -rf -- "$VALIDATION_ROOT"
}

trap cleanup EXIT

fail() {
  printf 'pinote check: %s\n' "$*" >&2
  exit 1
}

command -v omarchy >/dev/null 2>&1 ||
  fail "omarchy is required; install Omarchy 4.0.2 or newer"

command -v node >/dev/null 2>&1 ||
  fail "node is required for development checks"

command -v git >/dev/null 2>&1 ||
  fail "git is required to verify runtime deliverables"

if command -v qmllint >/dev/null 2>&1; then
  QMLLINT=$(command -v qmllint)
elif [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  QMLLINT=/usr/lib/qt6/bin/qmllint
else
  fail "qmllint was not found in PATH or at /usr/lib/qt6/bin/qmllint; install Qt 6 declarative tools"
fi

if command -v qmltestrunner >/dev/null 2>&1; then
  QMLTESTRUNNER=$(command -v qmltestrunner)
elif [[ -x /usr/lib/qt6/bin/qmltestrunner ]]; then
  QMLTESTRUNNER=/usr/lib/qt6/bin/qmltestrunner
else
  fail "qmltestrunner was not found in PATH or at /usr/lib/qt6/bin/qmltestrunner; install qt6-declarative"
fi

[[ -d $OMARCHY_SHELL_ROOT/Commons && -d $OMARCHY_SHELL_ROOT/Ui ]] ||
  fail "Omarchy QML imports were not found under $OMARCHY_SHELL_ROOT; set OMARCHY_SHELL_ROOT to the shell QML root"

# Quickshell maps the `qs` URI to its configuration root at runtime. Mirror
# that namespace so standalone qmllint resolves the same modules.
QML_IMPORT_MIRROR=$(mktemp -d)
mkdir -p "$QML_IMPORT_MIRROR/qs"
cp -R "$OMARCHY_SHELL_ROOT/Commons" "$QML_IMPORT_MIRROR/qs/Commons"
cp -R "$OMARCHY_SHELL_ROOT/Ui" "$QML_IMPORT_MIRROR/qs/Ui"

printf 'Validating manifest...\n'
helper_index_entry=$(git -C "$ROOT" ls-files --stage -- recovery-handoff)
[[ $helper_index_entry == 100755\ * ]] ||
  fail "recovery-handoff must be tracked with executable mode 100755"
VALIDATION_ROOT=$(mktemp -d)
runtime_files=(
  manifest.json BarWidget.qml Panel.qml NotesStore.qml PanelState.qml
  ModalKeyRouter.qml NotesModel.js NotesStoreQueue.js RuntimeIdentity.js
  recovery-handoff
)
for file in "${runtime_files[@]}"; do cp -- "$ROOT/$file" "$VALIDATION_ROOT/$file"; done
omarchy plugin validate "$VALIDATION_ROOT"

printf 'Testing JavaScript model...\n'
node --test "$ROOT/tests"/*.test.js

printf 'Checking shell scripts...\n'
for script in "$ROOT/scripts/check" "$ROOT/scripts/test-store" \
  "$ROOT/scripts/live-check" "$ROOT/scripts/live-test"; do
  [[ -x $script ]] || fail "$script must be executable"
  bash -n "$script"
done
[[ -x $ROOT/recovery-handoff ]] || fail "$ROOT/recovery-handoff must be executable"
/usr/bin/python3 -c 'compile(open(__import__("sys").argv[1], encoding="utf-8").read(), __import__("sys").argv[1], "exec")' \
  "$ROOT/recovery-handoff"

printf 'Linting QML...\n'
"$QMLLINT" -W 0 -I "$QML_IMPORT_MIRROR" \
  "$ROOT/RuntimeIdentity.js" \
  "$ROOT/NotesModel.js" \
  "$ROOT/NotesStoreQueue.js" \
  "$ROOT/BarWidget.qml" \
  "$ROOT/ModalKeyRouter.qml" \
  "$ROOT/PanelState.qml" \
  "$ROOT/NotesStore.qml" \
  "$ROOT/Panel.qml"

printf 'Testing QML interactions...\n'
QT_QPA_PLATFORM=offscreen QT_QUICK_CONTROLS_STYLE=Basic \
  "$QMLTESTRUNNER" -input "$ROOT/tests/qml" -import "$QML_IMPORT_MIRROR"

printf 'Testing persistent store...\n'
"$ROOT/scripts/test-store"

printf 'Pinote checks passed.\n'

node - "$RECOVERY_IDENTICAL_FAILURE_ROOT" <<'NODE'
const fs = require("node:fs")
const assert = require("node:assert/strict")
const root = process.argv[2]
const names = fs.readdirSync(`${root}/pinote`)
const expected = names.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
assert.equal(expected.length, 1)
assert.equal(fs.readFileSync(`${root}/pinote/${expected[0]}`, "utf8"), "{identical-original")
assert.equal(names.some(name => name.startsWith("notes.json.recovery-current-")), false)
assert.equal(names.some(name => name.startsWith(".pinote-recovery-")), false)
assert.deepEqual(JSON.parse(fs.readFileSync(`${root}/pinote/notes.json`, "utf8")),
  { version: 1, notes: [] })
NODE


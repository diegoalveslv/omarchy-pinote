  PINOTE_STORE_RECOVERY_HARDLINK_OK
[[ $(<"$RECOVERY_HARDLINK_PRIMARY_ROOT/outside-primary") == '{hardlink-primary' \
  && $(stat -c '%a' "$RECOVERY_HARDLINK_PRIMARY_ROOT/outside-primary") == 640 ]] || {

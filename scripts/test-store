  PINOTE_STORE_INTERRUPTED_SPECIAL_FILE_OK
run_recovery_case "$INTERRUPTED_RECOVERY_ROOT" interrupted-resume PINOTE_STORE_INTERRUPTED_RESUME_OK
run_recovery_case "$INTERRUPTED_INSTALLED_ROOT" interrupted-resume PINOTE_STORE_INTERRUPTED_RESUME_OK
set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$INTERRUPTED_HELPER_FAILURE_ROOT" \
  PINOTE_RECOVERY_HELPER_PATH="$INTERRUPTED_HELPER_FAILURE_ROOT/missing-helper" \
  PINOTE_RECOVERY_RETRY_HELPER_PATH="$CONFIG_ROOT/recovery-handoff" \
  PINOTE_STORE_SMOKE_MODE=interrupted-resume-helper-failure \
  timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"
if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_INTERRUPTED_HELPER_RETRY_OK* \
  || $OUTPUT == *PINOTE_STORE_SMOKE_FAILED* ]]; then
  printf 'pinote store test: interrupted helper retry failed\n' >&2
  exit 1
fi
set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$INTERRUPTED_HELPER_EXIT_ROOT" \
  PINOTE_RECOVERY_HELPER_PATH=/usr/bin/false \
  PINOTE_RECOVERY_RETRY_HELPER_PATH="$CONFIG_ROOT/recovery-handoff" \
  PINOTE_STORE_SMOKE_MODE=interrupted-resume-helper-failure \
  timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"
if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_INTERRUPTED_HELPER_RETRY_OK* \
  || $OUTPUT == *PINOTE_STORE_SMOKE_FAILED* ]]; then
  printf 'pinote store test: interrupted nonzero helper retry failed\n' >&2
  exit 1
fi
set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$INTERRUPTED_HELPER_ZERO_ROOT" \
  PINOTE_RECOVERY_HELPER_PATH=/usr/bin/true \
  PINOTE_RECOVERY_RETRY_HELPER_PATH="$CONFIG_ROOT/recovery-handoff" \
  PINOTE_STORE_SMOKE_MODE=interrupted-resume-helper-failure \
  timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"
if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_INTERRUPTED_HELPER_RETRY_OK* \
  || $OUTPUT == *PINOTE_STORE_SMOKE_FAILED* ]]; then
  printf 'pinote store test: interrupted zero-exit helper retry failed\n' >&2
  exit 1
fi
set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$INTERRUPTED_CLEANUP_FAILURE_ROOT" \
  PINOTE_RECOVERY_HELPER_PATH="$CONFIG_ROOT/recovery-handoff" \
  PINOTE_RECOVERY_RETRY_HELPER_PATH="$CONFIG_ROOT/recovery-handoff" \
  PINOTE_RECOVERY_CLEANUP_HOOK="$INTERRUPTED_CLEANUP_FAILURE_ROOT/cleanup" \
  PINOTE_RECOVERY_RETRY_CLEANUP_HOOK="" \
  PINOTE_STORE_SMOKE_TIMEOUT_MS=12000 \
  PINOTE_STORE_SMOKE_MODE=interrupted-resume-helper-failure \
  timeout 15s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"
if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_INTERRUPTED_HELPER_RETRY_OK* \
  || $OUTPUT == *PINOTE_STORE_SMOKE_FAILED* ]]; then
  printf 'pinote store test: interrupted cleanup retry failed\n' >&2
  exit 1
fi
run_recovery_case "$RECOVERY_ARCHIVE_FAILURE_ROOT" recovery-archive-failure PINOTE_STORE_RECOVERY_ARCHIVE_FAILURE_OK
run_recovery_case "$UNSUPPORTED_ROOT" unsupported PINOTE_STORE_UNSUPPORTED_OK

#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/pinote-store-test.XXXXXX")
CONFIG_ROOT="$TMP_ROOT/config"
STATE_ROOT="$TMP_ROOT/state"
ERROR_STATE_ROOT="$TMP_ROOT/error-state"
RETRY_STATE_ROOT="$TMP_ROOT/retry-state"
SHUTDOWN_STATE_ROOT="$TMP_ROOT/shutdown-state"
EXTERNAL_STATE_ROOT="$TMP_ROOT/external-state"
PERMISSION_STATE_ROOT="$TMP_ROOT/permission-state"
BACKUP_STATE_ROOT="$TMP_ROOT/backup-state"
DIRTY_STATE_ROOT="$TMP_ROOT/dirty-state"
MISMATCH_STATE_ROOT="$TMP_ROOT/mismatch-state"
RECOVERY_RESTORE_ROOT="$TMP_ROOT/recovery-restore-state"
RECOVERY_RESET_ROOT="$TMP_ROOT/recovery-reset-state"
RECOVERY_MISSING_ROOT="$TMP_ROOT/recovery-missing-state"
UNSUPPORTED_ROOT="$TMP_ROOT/unsupported-state"
RECOVERY_INVALID_ROOT="$TMP_ROOT/recovery-invalid-state"
RECOVERY_ARCHIVE_FAILURE_ROOT="$TMP_ROOT/recovery-archive-failure-state"
RECOVERY_CONFLICT_ROOT="$TMP_ROOT/recovery-conflict-state"
RECOVERY_WRITE_RETRY_ROOT="$TMP_ROOT/recovery-write-retry-state"
RECOVERY_BLANK_BACKUP_ROOT="$TMP_ROOT/recovery-blank-backup-state"
RECOVERY_WHITESPACE_BACKUP_ROOT="$TMP_ROOT/recovery-whitespace-backup-state"
RECOVERY_REPEAT_ROOT="$TMP_ROOT/recovery-repeat-state"
RECOVERY_HELPER_FAILURE_ROOT="$TMP_ROOT/recovery-helper-failure-state"
INTERRUPTED_RECOVERY_ROOT="$TMP_ROOT/interrupted-recovery-state"
RECOVERY_HANDOFF_RETRY_ROOT="$TMP_ROOT/recovery-handoff-retry-state"
RECOVERY_SHUTDOWN_ROOT="$TMP_ROOT/recovery-shutdown-state"
RECOVERY_BACKUP_CHANGE_ROOT="$TMP_ROOT/recovery-backup-change-state"
RECOVERY_VERIFICATION_RACE_ROOT="$TMP_ROOT/recovery-verification-race-state"
RECOVERY_MODE_ROOT="$TMP_ROOT/recovery-mode-state"
RECOVERY_CLEANUP_RACE_ROOT="$RECOVERY_CONFLICT_ROOT"
RECOVERY_INPLACE_ROOT="$TMP_ROOT/recovery-inplace-state"
RECOVERY_IDENTICAL_FAILURE_ROOT="$TMP_ROOT/recovery-identical-failure-state"
INTERRUPTED_INSTALLED_ROOT="$TMP_ROOT/interrupted-installed-state"
INTERRUPTED_HELPER_FAILURE_ROOT="$TMP_ROOT/interrupted-helper-failure-state"
INTERRUPTED_HELPER_EXIT_ROOT="$TMP_ROOT/interrupted-helper-exit-state"
INTERRUPTED_HELPER_ZERO_ROOT="$TMP_ROOT/interrupted-helper-zero-state"
INTERRUPTED_CLEANUP_FAILURE_ROOT="$TMP_ROOT/interrupted-cleanup-failure-state"
RECOVERY_SYMLINK_PRIMARY_ROOT="$TMP_ROOT/recovery-symlink-primary-state"
RECOVERY_SYMLINK_BACKUP_ROOT="$TMP_ROOT/recovery-symlink-backup-state"
RECOVERY_HARDLINK_PRIMARY_ROOT="$TMP_ROOT/recovery-hardlink-primary-state"
RECOVERY_IDENTICAL_POSTINSTALL_ROOT="$TMP_ROOT/recovery-identical-postinstall-state"
FIFO_PRIMARY_STATE_ROOT="$TMP_ROOT/fifo-primary-state"
FIFO_MARKER_STATE_ROOT="$TMP_ROOT/fifo-marker-state"
FIFO_STAGE_STATE_ROOT="$TMP_ROOT/fifo-stage-state"

cleanup() {
  rm -rf -- "$TMP_ROOT"
}

trap cleanup EXIT

command -v qs >/dev/null 2>&1 || {
  printf 'pinote store test: qs is required\n' >&2
  exit 1
}
command -v timeout >/dev/null 2>&1 || {
  printf 'pinote store test: timeout is required\n' >&2
  exit 1
}

mkdir -p "$CONFIG_ROOT" "$STATE_ROOT" "$ERROR_STATE_ROOT/pinote/notes.json" \
  "$RETRY_STATE_ROOT" "$SHUTDOWN_STATE_ROOT"
mkdir -p "$EXTERNAL_STATE_ROOT"
mkdir -p "$PERMISSION_STATE_ROOT" "$BACKUP_STATE_ROOT" "$DIRTY_STATE_ROOT" "$MISMATCH_STATE_ROOT"
mkdir -p "$RECOVERY_RESTORE_ROOT/pinote" "$RECOVERY_RESET_ROOT/pinote" \
  "$RECOVERY_MISSING_ROOT/pinote" "$UNSUPPORTED_ROOT/pinote"
mkdir -p "$RECOVERY_INVALID_ROOT/pinote" "$RECOVERY_ARCHIVE_FAILURE_ROOT/pinote"
mkdir -p "$RECOVERY_CONFLICT_ROOT/pinote"
mkdir -p "$RECOVERY_WRITE_RETRY_ROOT/pinote"
mkdir -p "$RECOVERY_BLANK_BACKUP_ROOT/pinote" "$RECOVERY_WHITESPACE_BACKUP_ROOT/pinote"
mkdir -p "$RECOVERY_REPEAT_ROOT/pinote" "$RECOVERY_HELPER_FAILURE_ROOT/pinote" \
  "$INTERRUPTED_RECOVERY_ROOT/pinote"
mkdir -p "$RECOVERY_HANDOFF_RETRY_ROOT/pinote" "$RECOVERY_SHUTDOWN_ROOT/pinote"
mkdir -p "$RECOVERY_BACKUP_CHANGE_ROOT/pinote" "$RECOVERY_VERIFICATION_RACE_ROOT/pinote" \
  "$RECOVERY_MODE_ROOT/pinote"
mkdir -p "$RECOVERY_INPLACE_ROOT/pinote" "$INTERRUPTED_INSTALLED_ROOT/pinote" \
  "$RECOVERY_SYMLINK_PRIMARY_ROOT/pinote" "$RECOVERY_SYMLINK_BACKUP_ROOT/pinote"
mkdir -p "$RECOVERY_IDENTICAL_FAILURE_ROOT/pinote"
mkdir -p "$INTERRUPTED_HELPER_FAILURE_ROOT/pinote" "$RECOVERY_HARDLINK_PRIMARY_ROOT/pinote"
mkdir -p "$INTERRUPTED_HELPER_EXIT_ROOT/pinote" "$RECOVERY_IDENTICAL_POSTINSTALL_ROOT/pinote"
mkdir -p "$INTERRUPTED_HELPER_ZERO_ROOT/pinote" "$INTERRUPTED_CLEANUP_FAILURE_ROOT/pinote"
mkdir -p "$FIFO_PRIMARY_STATE_ROOT/pinote" "$FIFO_MARKER_STATE_ROOT/pinote" \
  "$FIFO_STAGE_STATE_ROOT/pinote/notes.json.recovery-current-fifo"
mkdir -p "$PERMISSION_STATE_ROOT/pinote"
node -e 'require("node:fs").writeFileSync(process.argv[1], "{\"version\":1,\"notes\":[]}\n")' \
  "$PERMISSION_STATE_ROOT/pinote/notes.json"
chmod 000 "$PERMISSION_STATE_ROOT/pinote/notes.json"
node - "$RECOVERY_RESTORE_ROOT" "$RECOVERY_RESET_ROOT" "$RECOVERY_MISSING_ROOT" \
  "$UNSUPPORTED_ROOT" "$RECOVERY_INVALID_ROOT" "$RECOVERY_ARCHIVE_FAILURE_ROOT" \
  "$RECOVERY_CONFLICT_ROOT" "$RECOVERY_WRITE_RETRY_ROOT" \
  "$RECOVERY_BLANK_BACKUP_ROOT" "$RECOVERY_WHITESPACE_BACKUP_ROOT" \
  "$RECOVERY_REPEAT_ROOT" "$RECOVERY_HELPER_FAILURE_ROOT" "$INTERRUPTED_RECOVERY_ROOT" \
  "$RECOVERY_BACKUP_CHANGE_ROOT" "$RECOVERY_VERIFICATION_RACE_ROOT" \
  "$RECOVERY_MODE_ROOT" "$RECOVERY_INPLACE_ROOT" "$INTERRUPTED_INSTALLED_ROOT" \
  "$RECOVERY_SYMLINK_PRIMARY_ROOT" "$RECOVERY_SYMLINK_BACKUP_ROOT" \
  "$RECOVERY_IDENTICAL_FAILURE_ROOT" "$INTERRUPTED_HELPER_FAILURE_ROOT" \
  "$INTERRUPTED_HELPER_EXIT_ROOT" "$RECOVERY_HARDLINK_PRIMARY_ROOT" \
  "$RECOVERY_IDENTICAL_POSTINSTALL_ROOT" "$INTERRUPTED_HELPER_ZERO_ROOT" \
  "$INTERRUPTED_CLEANUP_FAILURE_ROOT" <<'NODE'
const fs = require("node:fs")
const path = require("node:path")

const [restoreRoot, resetRoot, missingRoot, unsupportedRoot, invalidRoot, archiveFailureRoot,
  conflictRoot, writeRetryRoot, blankBackupRoot, whitespaceBackupRoot, repeatRoot,
  helperFailureRoot, interruptedRoot, backupChangeRoot, verificationRaceRoot,
  modeRoot, inplaceRoot, interruptedInstalledRoot, symlinkPrimaryRoot,
  symlinkBackupRoot, identicalFailureRoot, interruptedHelperFailureRoot,
  interruptedHelperExitRoot, hardlinkPrimaryRoot, identicalPostinstallRoot,
  interruptedHelperZeroRoot, interruptedCleanupFailureRoot] = process.argv.slice(2)
const valid = content => JSON.stringify({
  version: 1,
  notes: [{
    id: "recovery-note",
    content,
    createdAt: "2026-09-10T12:00:00.000Z",
    updatedAt: "2026-09-10T12:00:00.000Z"
  }]
}, null, 2) + "\n"
const partial = JSON.stringify({
  version: 1,
  notes: [JSON.parse(valid("Preview note")).notes[0], {
    id: "invalid-note",
    content: "",
    createdAt: "invalid",
    updatedAt: "invalid"
  }]
}, null, 2) + "\n"

fs.writeFileSync(path.join(restoreRoot, "pinote/notes.json"), partial)
fs.writeFileSync(path.join(restoreRoot, "original-primary"), partial)
fs.writeFileSync(path.join(restoreRoot, "pinote/notes.json.bak"), valid("Backup recovery note"))
fs.writeFileSync(path.join(resetRoot, "pinote/notes.json"), "{PINOTE_PRIVATE_SENTINEL_8f92")
fs.writeFileSync(path.join(resetRoot, "pinote/notes.json.bak"), valid("PINOTE_PRIVATE_SENTINEL_8f92"))
fs.writeFileSync(path.join(missingRoot, "pinote/notes.json"), "{broken")
fs.writeFileSync(path.join(unsupportedRoot, "pinote/notes.json"), '{"version":1.5,"unknown":"shape"}\n')
fs.writeFileSync(path.join(invalidRoot, "pinote/notes.json"), "{broken-primary")
fs.writeFileSync(path.join(invalidRoot, "pinote/notes.json.bak"), "{broken-backup")
fs.writeFileSync(path.join(archiveFailureRoot, "pinote/notes.json"), "{archive-must-remain")
fs.writeFileSync(path.join(conflictRoot, "pinote/notes.json"), "{conflict-original")
fs.writeFileSync(path.join(conflictRoot, "pinote/notes.json.bak"), valid("Backup handoff note"))
fs.writeFileSync(path.join(conflictRoot, "injected.json"), valid("External handoff note"))
fs.writeFileSync(path.join(conflictRoot, "injected-cleanup.json"), valid("External cleanup note"))
fs.writeFileSync(path.join(writeRetryRoot, "pinote/notes.json"), "{write-retry-original")
fs.writeFileSync(path.join(writeRetryRoot, "pinote/notes.json.bak"), valid("Write retry backup"))
fs.writeFileSync(path.join(blankBackupRoot, "pinote/notes.json"), "{blank-backup-primary")
fs.writeFileSync(path.join(blankBackupRoot, "pinote/notes.json.bak"), "")
fs.writeFileSync(path.join(whitespaceBackupRoot, "pinote/notes.json"), "{whitespace-backup-primary")
fs.writeFileSync(path.join(whitespaceBackupRoot, "pinote/notes.json.bak"), " \n\t ")
fs.writeFileSync(path.join(repeatRoot, "pinote/notes.json"), "{first-damaged-primary")
fs.writeFileSync(path.join(helperFailureRoot, "pinote/notes.json"), "{helper-failure-primary")
fs.writeFileSync(path.join(backupChangeRoot, "pinote/notes.json"), "{backup-change-primary")
fs.writeFileSync(path.join(backupChangeRoot, "pinote/notes.json.bak"), valid("Original backup note"))
fs.writeFileSync(path.join(verificationRaceRoot, "pinote/notes.json"), "{verification-race-primary")
fs.writeFileSync(path.join(modeRoot, "pinote/notes.json"), "{mode-primary", { mode: 0o600 })
fs.writeFileSync(path.join(modeRoot, "pinote/notes.json.bak"), valid("Mode backup"), { mode: 0o600 })
fs.writeFileSync(path.join(inplaceRoot, "pinote/notes.json"), "{inplace-original")
fs.writeFileSync(path.join(inplaceRoot, "injected.json"), valid("External in-place note"))
fs.writeFileSync(path.join(identicalFailureRoot, "pinote/notes.json"), "{identical-original")
fs.writeFileSync(path.join(identicalFailureRoot, "injected.json"),
  JSON.stringify({ version: 1, notes: [] }, null, 2) + "\n")

const interruptedDir = path.join(interruptedRoot, "pinote")
const expectedArchive = path.join(interruptedDir, "notes.json.recovery-interrupted")
const currentArchiveDir = path.join(interruptedDir, "notes.json.recovery-current-interrupted")
const currentArchive = path.join(currentArchiveDir, "notes.json")
const staged = path.join(interruptedDir, ".pinote-recovery-stage-interrupted")
fs.mkdirSync(currentArchiveDir, { mode: 0o700 })
fs.writeFileSync(expectedArchive, "{interrupted-original")
fs.writeFileSync(currentArchive, "{interrupted-original")
fs.writeFileSync(staged, valid("Interrupted replacement"))
fs.writeFileSync(path.join(interruptedDir, "notes.json.bak"), valid("Changed restart backup"))
fs.writeFileSync(path.join(interruptedDir, ".pinote-recovery-transaction.json"), JSON.stringify({
  version: 1,
  action: "restore",
  expectedArchive,
  currentArchive,
  staged
}, null, 2) + "\n")

const installedDir = path.join(interruptedInstalledRoot, "pinote")
const installedExpected = path.join(installedDir, "notes.json.recovery-installed")
const installedCurrentDir = path.join(installedDir, "notes.json.recovery-current-installed")
const installedCurrent = path.join(installedCurrentDir, "notes.json")
const installedStage = path.join(installedDir, ".pinote-recovery-stage-installed")
fs.mkdirSync(installedCurrentDir, { mode: 0o700 })
fs.writeFileSync(installedExpected, "{installed-original")
fs.writeFileSync(installedCurrent, "{installed-original")
fs.writeFileSync(installedStage, valid("Interrupted replacement"))
fs.linkSync(installedStage, path.join(installedDir, "notes.json"))
fs.writeFileSync(path.join(installedDir, ".pinote-recovery-transaction.json"), JSON.stringify({
  version: 1,
  action: "restore",
  expectedArchive: installedExpected,
  currentArchive: installedCurrent,
  staged: installedStage
}, null, 2) + "\n")

const interruptedHelperDir = path.join(interruptedHelperFailureRoot, "pinote")
const helperExpected = path.join(interruptedHelperDir, "notes.json.recovery-helper-failure")
const helperCurrentDir = path.join(interruptedHelperDir, "notes.json.recovery-current-helper-failure")
const helperCurrent = path.join(helperCurrentDir, "notes.json")
const helperStage = path.join(interruptedHelperDir, ".pinote-recovery-stage-helper-failure")
fs.mkdirSync(helperCurrentDir, { mode: 0o700 })
fs.writeFileSync(helperExpected, "{interrupted-helper-original")
fs.writeFileSync(helperCurrent, "{interrupted-helper-original")
fs.writeFileSync(helperStage, valid("Interrupted replacement"))
fs.writeFileSync(path.join(interruptedHelperDir, ".pinote-recovery-transaction.json"), JSON.stringify({
  version: 1,
  action: "restore",
  expectedArchive: helperExpected,
  currentArchive: helperCurrent,
  staged: helperStage
}, null, 2) + "\n")

const interruptedExitDir = path.join(interruptedHelperExitRoot, "pinote")
const exitExpected = path.join(interruptedExitDir, "notes.json.recovery-helper-exit")
const exitCurrentDir = path.join(interruptedExitDir, "notes.json.recovery-current-helper-exit")
const exitCurrent = path.join(exitCurrentDir, "notes.json")
const exitStage = path.join(interruptedExitDir, ".pinote-recovery-stage-helper-exit")
fs.mkdirSync(exitCurrentDir, { mode: 0o700 })
fs.writeFileSync(exitExpected, "{interrupted-exit-original")
fs.writeFileSync(exitCurrent, "{interrupted-exit-original")
fs.writeFileSync(exitStage, valid("Interrupted replacement"))
fs.writeFileSync(path.join(interruptedExitDir, ".pinote-recovery-transaction.json"), JSON.stringify({
  version: 1,
  action: "restore",
  expectedArchive: exitExpected,
  currentArchive: exitCurrent,
  staged: exitStage
}, null, 2) + "\n")

for (const [root, suffix] of [[interruptedHelperZeroRoot, "helper-zero"],
  [interruptedCleanupFailureRoot, "cleanup-failure"]]) {
  const directory = path.join(root, "pinote")
  const expectedArchive = path.join(directory, `notes.json.recovery-${suffix}`)
  const currentDirectory = path.join(directory, `notes.json.recovery-current-${suffix}`)
  const currentArchive = path.join(currentDirectory, "notes.json")
  const staged = path.join(directory, `.pinote-recovery-stage-${suffix}`)
  fs.mkdirSync(currentDirectory, { mode: 0o700 })
  fs.writeFileSync(expectedArchive, `{interrupted-${suffix}-original`)
  fs.writeFileSync(currentArchive, `{interrupted-${suffix}-original`)
  fs.writeFileSync(staged, valid("Interrupted replacement"))
  fs.writeFileSync(path.join(directory, ".pinote-recovery-transaction.json"), JSON.stringify({
    version: 1,
    action: "restore",
    expectedArchive,
    currentArchive,
    staged
  }, null, 2) + "\n")
}

const primaryTarget = path.join(symlinkPrimaryRoot, "external-primary")
fs.writeFileSync(primaryTarget, "{symlink-primary-target", { mode: 0o640 })
fs.symlinkSync(primaryTarget, path.join(symlinkPrimaryRoot, "pinote/notes.json"))

const backupTarget = path.join(symlinkBackupRoot, "external-backup")
fs.writeFileSync(path.join(symlinkBackupRoot, "pinote/notes.json"), "{symlink-backup-primary")
fs.writeFileSync(backupTarget, valid("Symlink backup target"), { mode: 0o640 })
fs.symlinkSync(backupTarget, path.join(symlinkBackupRoot, "pinote/notes.json.bak"))

const hardlinkPrimary = path.join(hardlinkPrimaryRoot, "pinote/notes.json")
const hardlinkOutside = path.join(hardlinkPrimaryRoot, "outside-primary")
fs.writeFileSync(hardlinkPrimary, "{hardlink-primary", { mode: 0o640 })
fs.linkSync(hardlinkPrimary, hardlinkOutside)
fs.writeFileSync(path.join(identicalPostinstallRoot, "pinote/notes.json"),
  "{identical-postinstall-original")
NODE
mkfifo "$FIFO_PRIMARY_STATE_ROOT/pinote/notes.json"
mkfifo "$FIFO_MARKER_STATE_ROOT/pinote/.pinote-recovery-transaction.json"
printf '%s' '{fifo-original' > "$FIFO_STAGE_STATE_ROOT/pinote/notes.json.recovery-fifo"
printf '%s' '{fifo-original' \
  > "$FIFO_STAGE_STATE_ROOT/pinote/notes.json.recovery-current-fifo/notes.json"
mkfifo "$FIFO_STAGE_STATE_ROOT/pinote/.pinote-recovery-stage-fifo"
node - "$FIFO_STAGE_STATE_ROOT/pinote" <<'NODE'
const fs = require("node:fs")
const path = require("node:path")
const root = process.argv[2]
fs.writeFileSync(path.join(root, ".pinote-recovery-transaction.json"), JSON.stringify({
  version: 1,
  action: "restore",
  expectedArchive: path.join(root, "notes.json.recovery-fifo"),
  currentArchive: path.join(root, "notes.json.recovery-current-fifo/notes.json"),
  staged: path.join(root, ".pinote-recovery-stage-fifo")
}, null, 2) + "\n")
NODE
printf '%s' '{handoff-retry-original' > "$RECOVERY_HANDOFF_RETRY_ROOT/pinote/notes.json"
printf '%s' '{shutdown-recovery-original' > "$RECOVERY_SHUTDOWN_ROOT/pinote/notes.json"
cp "$ROOT/NotesModel.js" "$ROOT/NotesStoreQueue.js" "$ROOT/NotesStore.qml" "$CONFIG_ROOT/"
cp "$ROOT/recovery-handoff" "$CONFIG_ROOT/"
cp "$ROOT/tests/StoreSmoke.qml" "$CONFIG_ROOT/"

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$STATE_ROOT" \
  timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_SMOKE_OK* ]]; then
  printf 'pinote store test: Quickshell smoke test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=reload timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_RELOAD_OK* ]]; then
  printf 'pinote store test: restart load test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$ERROR_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=expect-load-error timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_LOAD_ERROR_OK* ]]; then
  printf 'pinote store test: path-type load test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$RETRY_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=save-retry timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_RETRY_OK* ]]; then
  printf 'pinote store test: failed-save retry test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$SHUTDOWN_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=shutdown timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_SHUTDOWN_STARTED* ]]; then
  printf 'pinote store test: shutdown flush test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$EXTERNAL_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=external timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_EXTERNAL_OK* ]]; then
  printf 'pinote store test: external-change watcher test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$PERMISSION_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=expect-permission-load timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
chmod 600 "$PERMISSION_STATE_ROOT/pinote/notes.json"
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_PERMISSION_OK* ]]; then
  printf 'pinote store test: permission-denial test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$BACKUP_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=backup-retry timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_BACKUP_RETRY_OK* ]]; then
  printf 'pinote store test: backup retry test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$DIRTY_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=dirty-external timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_DIRTY_EXTERNAL_OK* ]]; then
  printf 'pinote store test: dirty external-change test failed\n' >&2
  exit 1
fi

set +e
OUTPUT=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$MISMATCH_STATE_ROOT" \
  PINOTE_STORE_SMOKE_MODE=verify-mismatch timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

if [[ $STATUS -ne 0 || $OUTPUT != *PINOTE_STORE_VERIFY_MISMATCH_OK* ]]; then
  printf 'pinote store test: primary verification mismatch test failed\n' >&2
  exit 1
fi

run_recovery_case() {
  local state_root=$1
  local mode=$2
  local marker=$3
  local output status
  set +e
  output=$(QT_LOGGING_RULES="qt.qpa.services=false" XDG_STATE_HOME="$state_root" \
    PINOTE_STORE_SMOKE_MODE="$mode" timeout 10s qs --no-color -p "$CONFIG_ROOT/StoreSmoke.qml" 2>&1)
  status=$?
  set -e
  printf '%s\n' "$output"
  if [[ $status -ne 0 || $output != *"$marker"* || $output == *PINOTE_STORE_SMOKE_FAILED* ]]; then
    printf 'pinote store test: %s failed\n' "$mode" >&2
    exit 1
  fi
  if [[ $output == *PINOTE_PRIVATE_SENTINEL_8f92* ]]; then
    printf 'pinote store test: private note content leaked to logs\n' >&2
    exit 1
  fi
}

run_recovery_case "$RECOVERY_RESTORE_ROOT" recovery-restore PINOTE_STORE_RECOVERY_RESTORE_OK
run_recovery_case "$RECOVERY_RESET_ROOT" recovery-reset PINOTE_STORE_RECOVERY_RESET_OK
run_recovery_case "$RECOVERY_MISSING_ROOT" recovery-missing-backup PINOTE_STORE_RECOVERY_MISSING_BACKUP_OK
run_recovery_case "$RECOVERY_INVALID_ROOT" recovery-invalid-backup PINOTE_STORE_RECOVERY_INVALID_BACKUP_OK
run_recovery_case "$RECOVERY_BLANK_BACKUP_ROOT" recovery-invalid-backup PINOTE_STORE_RECOVERY_INVALID_BACKUP_OK

  PINOTE_STORE_RECOVERY_BACKUP_CHANGE_OK
run_recovery_case "$RECOVERY_VERIFICATION_RACE_ROOT" recovery-verification-race \
  PINOTE_STORE_RECOVERY_VERIFICATION_RACE_OK
(umask 000; run_recovery_case "$RECOVERY_MODE_ROOT" recovery-reset PINOTE_STORE_RECOVERY_RESET_OK)

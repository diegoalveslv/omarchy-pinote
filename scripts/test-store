printf '%s' marker > "$ROLLBACK_RACE_ROOT/marker"
printf '%s' '{rollback-race-external' > "$ROLLBACK_RACE_ROOT/external-primary"
: > "$ROLLBACK_RACE_ROOT/hook.continue"
: > "$ROLLBACK_RACE_ROOT/hook.continue-install"
: > "$ROLLBACK_RACE_ROOT/hook.pause-before-link"
: > "$ROLLBACK_RACE_ROOT/hook.pause-before-rollback"
(
  for _ in {1..500}; do [[ -e $ROLLBACK_RACE_ROOT/hook.prelink-ready ]] && break; sleep 0.01; done
  [[ -e $ROLLBACK_RACE_ROOT/hook.prelink-ready ]] || exit 1
  ln -- "$ROLLBACK_RACE_ROOT/staged" "$ROLLBACK_RACE_ROOT/outside-stage"
  rm -- "$ROLLBACK_RACE_ROOT/staged"
  : > "$ROLLBACK_RACE_ROOT/hook.prelink-continue"
  for _ in {1..500}; do [[ -e $ROLLBACK_RACE_ROOT/hook.rollback-ready ]] && break; sleep 0.01; done
  [[ -e $ROLLBACK_RACE_ROOT/hook.rollback-ready ]] || exit 1
  rm -- "$ROLLBACK_RACE_ROOT/notes.json"
  mv -- "$ROLLBACK_RACE_ROOT/external-primary" "$ROLLBACK_RACE_ROOT/notes.json"
  : > "$ROLLBACK_RACE_ROOT/hook.rollback-continue"
) &
ROLLBACK_RACE_PID=$!
set +e
"$ROOT/recovery-handoff" install "$ROLLBACK_RACE_ROOT/archive" \
  "$ROLLBACK_RACE_ROOT/current-archive/notes.json" "$ROLLBACK_RACE_ROOT/staged" \
  "$ROLLBACK_RACE_ROOT/notes.json" "$ROLLBACK_RACE_ROOT/marker" "$ROLLBACK_RACE_ROOT/hook"
ROLLBACK_RACE_STATUS=$?
set -e
wait "$ROLLBACK_RACE_PID"
[[ $ROLLBACK_RACE_STATUS -eq 75 \
  && $(<"$ROLLBACK_RACE_ROOT/notes.json") == '{rollback-race-external' \
  && $(<"$ROLLBACK_RACE_ROOT/current-archive/notes.json") == '{rollback-race-original' \
  && $(stat -c '%h' "$ROLLBACK_RACE_ROOT/outside-stage") == 1 ]] || {
  printf 'pinote store test: rollback removed a concurrent replacement primary\n' >&2
  exit 1
}

FIFO_ROOT="$TMP_ROOT/fifo-helper"
mkdir -p "$FIFO_ROOT"
mkfifo "$FIFO_ROOT/notes.json"
set +e
timeout 2s "$ROOT/recovery-handoff" archive "$FIFO_ROOT/notes.json" \
  "$FIFO_ROOT/archive" ""
FIFO_STATUS=$?
set -e
[[ $FIFO_STATUS -eq 73 && ! -e $FIFO_ROOT/archive ]] || {
  printf 'pinote store test: FIFO recovery input did not fail promptly\n' >&2
  exit 1
}

LINK_FAILURE_ROOT="$TMP_ROOT/link-failure-helper"
mkdir -p "$LINK_FAILURE_ROOT/hook"
printf '%s' '{link-failure-original' > "$LINK_FAILURE_ROOT/notes.json"
cp -- "$LINK_FAILURE_ROOT/notes.json" "$LINK_FAILURE_ROOT/archive"
cp -- "$RECOVERY_RESET_ROOT/pinote/notes.json" "$LINK_FAILURE_ROOT/staged"
printf '%s' marker > "$LINK_FAILURE_ROOT/marker"
: > "$LINK_FAILURE_ROOT/hook.continue"
: > "$LINK_FAILURE_ROOT/hook.continue-install"
: > "$LINK_FAILURE_ROOT/hook.fail-link"
set +e
"$ROOT/recovery-handoff" install "$LINK_FAILURE_ROOT/archive" \
  "$LINK_FAILURE_ROOT/current-archive/notes.json" "$LINK_FAILURE_ROOT/staged" \
  "$LINK_FAILURE_ROOT/notes.json" "$LINK_FAILURE_ROOT/marker" "$LINK_FAILURE_ROOT/hook"
LINK_STATUS=$?
set -e
[[ $LINK_STATUS -ne 0 && ! -e $LINK_FAILURE_ROOT/notes.json \
  && -f $LINK_FAILURE_ROOT/current-archive/notes.json && -f $LINK_FAILURE_ROOT/staged ]] || {
  printf 'pinote store test: hard-link failure was not fail-safe\n' >&2
  exit 1
}
"$ROOT/recovery-handoff" resume "$LINK_FAILURE_ROOT/archive" \
  "$LINK_FAILURE_ROOT/current-archive/notes.json" "$LINK_FAILURE_ROOT/staged" \
  "$LINK_FAILURE_ROOT/notes.json" "$LINK_FAILURE_ROOT/marker"
cmp -s -- "$LINK_FAILURE_ROOT/notes.json" "$RECOVERY_RESET_ROOT/pinote/notes.json" || {
  printf 'pinote store test: hard-link failure resume installed the wrong payload\n' >&2
  exit 1
}
[[ $(stat -c '%a' "$LINK_FAILURE_ROOT/notes.json") == 600 ]] || {
  printf 'pinote store test: resumed hard-link payload has unsafe permissions\n' >&2
  exit 1
}

LINK_RACE_ROOT="$TMP_ROOT/link-race-helper"
mkdir -p "$LINK_RACE_ROOT"
printf '%s' '{link-race-original' > "$LINK_RACE_ROOT/notes.json"
cp -- "$LINK_RACE_ROOT/notes.json" "$LINK_RACE_ROOT/archive"
cp -- "$RECOVERY_RESET_ROOT/pinote/notes.json" "$LINK_RACE_ROOT/staged"
printf '%s' marker > "$LINK_RACE_ROOT/marker"
: > "$LINK_RACE_ROOT/hook.continue"
(
  for _ in {1..500}; do [[ -e $LINK_RACE_ROOT/hook.moved ]] && break; sleep 0.01; done
  [[ -e $LINK_RACE_ROOT/hook.moved ]] || exit 1
  printf '%s' '{link-race-external' > "$LINK_RACE_ROOT/notes.json"
  : > "$LINK_RACE_ROOT/hook.continue-install"
) &
LINK_RACE_PID=$!
set +e
"$ROOT/recovery-handoff" install "$LINK_RACE_ROOT/archive" \
  "$LINK_RACE_ROOT/current-archive/notes.json" "$LINK_RACE_ROOT/staged" \
  "$LINK_RACE_ROOT/notes.json" "$LINK_RACE_ROOT/marker" "$LINK_RACE_ROOT/hook"
LINK_RACE_STATUS=$?
set -e
wait "$LINK_RACE_PID"
[[ $LINK_RACE_STATUS -ne 0 \
  && $(<"$LINK_RACE_ROOT/notes.json") == '{link-race-external' \
  && $(<"$LINK_RACE_ROOT/current-archive/notes.json") == '{link-race-original' \
  && -f $LINK_RACE_ROOT/staged ]] || {
  printf 'pinote store test: concurrent hard-link destination was not preserved\n' >&2
  exit 1
}

SYMLINK_RACE_ROOT="$TMP_ROOT/symlink-race-helper"
mkdir -p "$SYMLINK_RACE_ROOT"
printf '%s' '{symlink-race-original' > "$SYMLINK_RACE_ROOT/notes.json"
cp -- "$SYMLINK_RACE_ROOT/notes.json" "$SYMLINK_RACE_ROOT/archive"
cp -- "$RECOVERY_RESET_ROOT/pinote/notes.json" "$SYMLINK_RACE_ROOT/staged"
printf '%s' marker > "$SYMLINK_RACE_ROOT/marker"
printf '%s' outside > "$SYMLINK_RACE_ROOT/outside"
chmod 640 "$SYMLINK_RACE_ROOT/outside"
(
  for _ in {1..500}; do [[ -e $SYMLINK_RACE_ROOT/hook.ready ]] && break; sleep 0.01; done
  [[ -e $SYMLINK_RACE_ROOT/hook.ready ]] || exit 1
  mv -- "$SYMLINK_RACE_ROOT/staged" "$SYMLINK_RACE_ROOT/retained-stage"
  mv -- "$SYMLINK_RACE_ROOT/marker" "$SYMLINK_RACE_ROOT/retained-marker"
  ln -s -- "$SYMLINK_RACE_ROOT/outside" "$SYMLINK_RACE_ROOT/staged"
  ln -s -- "$SYMLINK_RACE_ROOT/outside" "$SYMLINK_RACE_ROOT/marker"
  : > "$SYMLINK_RACE_ROOT/hook.continue"
  for _ in {1..500}; do [[ -e $SYMLINK_RACE_ROOT/hook.moved ]] && break; sleep 0.01; done
  [[ -e $SYMLINK_RACE_ROOT/hook.moved ]] || exit 1
  : > "$SYMLINK_RACE_ROOT/hook.continue-install"
) &
SYMLINK_RACE_PID=$!
set +e
"$ROOT/recovery-handoff" install "$SYMLINK_RACE_ROOT/archive" \
  "$SYMLINK_RACE_ROOT/current-archive/notes.json" "$SYMLINK_RACE_ROOT/staged" \
  "$SYMLINK_RACE_ROOT/notes.json" "$SYMLINK_RACE_ROOT/marker" \
  "$SYMLINK_RACE_ROOT/hook"
SYMLINK_RACE_STATUS=$?
set -e
wait "$SYMLINK_RACE_PID"
[[ $SYMLINK_RACE_STATUS -eq 75 && ! -e $SYMLINK_RACE_ROOT/current-archive \
  && $(<"$SYMLINK_RACE_ROOT/notes.json") == '{symlink-race-original' \
  && -f $SYMLINK_RACE_ROOT/retained-stage && -f $SYMLINK_RACE_ROOT/retained-marker \
  && -L $SYMLINK_RACE_ROOT/staged && -L $SYMLINK_RACE_ROOT/marker \
  && $(<"$SYMLINK_RACE_ROOT/outside") == outside \
  && $(stat -c '%a' "$SYMLINK_RACE_ROOT/outside") == 640 ]] || {
  printf 'pinote store test: raced recovery symlinks were not rejected safely\n' >&2
  exit 1
}

DIRECTORY_RACE_ROOT="$TMP_ROOT/directory-race-helper"
mkdir -p "$DIRECTORY_RACE_ROOT/outside-directory"
printf '%s' '{directory-race-original' > "$DIRECTORY_RACE_ROOT/notes.json"
cp -- "$DIRECTORY_RACE_ROOT/notes.json" "$DIRECTORY_RACE_ROOT/archive"
cp -- "$RECOVERY_RESET_ROOT/pinote/notes.json" "$DIRECTORY_RACE_ROOT/staged"
printf '%s' marker > "$DIRECTORY_RACE_ROOT/marker"
printf '%s' outside > "$DIRECTORY_RACE_ROOT/outside-directory/outside"
chmod 640 "$DIRECTORY_RACE_ROOT/outside-directory/outside"
(
  for _ in {1..500}; do [[ -e $DIRECTORY_RACE_ROOT/hook.ready ]] && break; sleep 0.01; done
  [[ -e $DIRECTORY_RACE_ROOT/hook.ready ]] || exit 1
  : > "$DIRECTORY_RACE_ROOT/hook.continue"
  for _ in {1..500}; do [[ -e $DIRECTORY_RACE_ROOT/hook.moved ]] && break; sleep 0.01; done
  [[ -e $DIRECTORY_RACE_ROOT/hook.moved ]] || exit 1
  mv -- "$DIRECTORY_RACE_ROOT/current-archive" "$DIRECTORY_RACE_ROOT/retained-current"
  ln -s -- "$DIRECTORY_RACE_ROOT/outside-directory" "$DIRECTORY_RACE_ROOT/current-archive"
  : > "$DIRECTORY_RACE_ROOT/hook.continue-install"
) &
DIRECTORY_RACE_PID=$!
set +e
"$ROOT/recovery-handoff" install "$DIRECTORY_RACE_ROOT/archive" \
  "$DIRECTORY_RACE_ROOT/current-archive/notes.json" "$DIRECTORY_RACE_ROOT/staged" \
  "$DIRECTORY_RACE_ROOT/notes.json" "$DIRECTORY_RACE_ROOT/marker" \
  "$DIRECTORY_RACE_ROOT/hook"
DIRECTORY_RACE_STATUS=$?
set -e
wait "$DIRECTORY_RACE_PID"
[[ $DIRECTORY_RACE_STATUS -eq 68 \
  && $(<"$DIRECTORY_RACE_ROOT/outside-directory/outside") == outside \
  && $(stat -c '%a' "$DIRECTORY_RACE_ROOT/outside-directory/outside") == 640 \
  && $(<"$DIRECTORY_RACE_ROOT/notes.json") == '{directory-race-original' \
  && -L $DIRECTORY_RACE_ROOT/current-archive \
  && -d $DIRECTORY_RACE_ROOT/retained-current \
  && ! -e $DIRECTORY_RACE_ROOT/retained-current/notes.json ]] || {
  printf 'pinote store test: current-archive directory race was not contained\n' >&2
  exit 1
}

RENAME_RETRY_ROOT="$TMP_ROOT/rename-retry-helper"
mkdir -p "$RENAME_RETRY_ROOT"
printf '%s' '{rename-retry-original' > "$RENAME_RETRY_ROOT/notes.json"
cp -- "$RENAME_RETRY_ROOT/notes.json" "$RENAME_RETRY_ROOT/archive"
cp -- "$RECOVERY_RESET_ROOT/pinote/notes.json" "$RENAME_RETRY_ROOT/staged"
printf '%s' marker > "$RENAME_RETRY_ROOT/marker"
(
  for _ in {1..500}; do [[ -e $RENAME_RETRY_ROOT/hook.ready ]] && break; sleep 0.01; done
  [[ -e $RENAME_RETRY_ROOT/hook.ready ]] || exit 1
  mv -- "$RENAME_RETRY_ROOT/notes.json" "$RENAME_RETRY_ROOT/held-primary"
  : > "$RENAME_RETRY_ROOT/hook.continue"
) &
RENAME_RETRY_PID=$!
set +e
"$ROOT/recovery-handoff" install "$RENAME_RETRY_ROOT/archive" \
  "$RENAME_RETRY_ROOT/current-archive/notes.json" "$RENAME_RETRY_ROOT/staged" \
  "$RENAME_RETRY_ROOT/notes.json" "$RENAME_RETRY_ROOT/marker" \
  "$RENAME_RETRY_ROOT/hook"
RENAME_RETRY_STATUS=$?
set -e
wait "$RENAME_RETRY_PID"
[[ $RENAME_RETRY_STATUS -ne 0 && ! -e $RENAME_RETRY_ROOT/current-archive ]] || {
  printf 'pinote store test: failed rename left a retry-poisoning archive directory\n' >&2
  exit 1
}
mv -- "$RENAME_RETRY_ROOT/held-primary" "$RENAME_RETRY_ROOT/notes.json"
"$ROOT/recovery-handoff" install "$RENAME_RETRY_ROOT/archive" \
  "$RENAME_RETRY_ROOT/current-archive/notes.json" "$RENAME_RETRY_ROOT/staged" \
  "$RENAME_RETRY_ROOT/notes.json" "$RENAME_RETRY_ROOT/marker"
cmp -s -- "$RENAME_RETRY_ROOT/notes.json" "$RENAME_RETRY_ROOT/staged" || {
  printf 'pinote store test: retry after failed rename installed the wrong payload\n' >&2
  exit 1
}

node - "$STATE_ROOT/pinote/notes.json" "$STATE_ROOT/pinote/notes.json.bak" \
  "$RETRY_STATE_ROOT/pinote/notes.json" "$RETRY_STATE_ROOT/pinote/notes.json.bak" \
  "$SHUTDOWN_STATE_ROOT/pinote/notes.json" \
  "$BACKUP_STATE_ROOT/pinote/notes.json" "$BACKUP_STATE_ROOT/pinote/notes.json.bak" \
  "$DIRTY_STATE_ROOT/pinote/notes.json" "$MISMATCH_STATE_ROOT/pinote/notes.json" \
  "$RECOVERY_RESTORE_ROOT" "$RECOVERY_RESET_ROOT" "$UNSUPPORTED_ROOT" \
  "$RECOVERY_ARCHIVE_FAILURE_ROOT" "$RECOVERY_CONFLICT_ROOT" \
  "$INTERRUPTED_RECOVERY_ROOT" "$RECOVERY_HANDOFF_RETRY_ROOT" \
  "$RECOVERY_SHUTDOWN_ROOT" "$RECOVERY_BACKUP_CHANGE_ROOT" \
  "$RECOVERY_VERIFICATION_RACE_ROOT" "$RECOVERY_MODE_ROOT" \
  "$RECOVERY_REPEAT_ROOT" "$RECOVERY_WRITE_RETRY_ROOT" \
  "$RECOVERY_HELPER_FAILURE_ROOT" "$RECOVERY_INPLACE_ROOT" \
  "$INTERRUPTED_INSTALLED_ROOT" "$RECOVERY_SYMLINK_PRIMARY_ROOT" \
  "$RECOVERY_SYMLINK_BACKUP_ROOT" <<'NODE'
const fs = require("node:fs")
const assert = require("node:assert/strict")

const primary = fs.readFileSync(process.argv[2], "utf8")
const backup = fs.readFileSync(process.argv[3], "utf8")
assert.equal(backup, primary)
assert.ok(primary.endsWith("\n"))

const parsed = JSON.parse(primary)
assert.equal(parsed.version, 1)
assert.equal(parsed.notes.length, 1)
assert.equal(parsed.notes[0].content, "Updated note\nwith two lines")

const retryPrimary = fs.readFileSync(process.argv[4], "utf8")
const retryBackup = fs.readFileSync(process.argv[5], "utf8")
assert.equal(retryBackup, retryPrimary)
assert.equal(JSON.parse(retryPrimary).notes[0].content, "Recovered save")

const shutdownPrimary = fs.readFileSync(process.argv[6], "utf8")
assert.equal(JSON.parse(shutdownPrimary).notes.length, 1)
assert.equal(JSON.parse(shutdownPrimary).notes[0].content, "Latest shutdown snapshot")

const backupPrimary = fs.readFileSync(process.argv[7], "utf8")
assert.equal(fs.readFileSync(process.argv[8], "utf8"), backupPrimary)
assert.equal(JSON.parse(backupPrimary).notes[0].content, "Backup retry")

assert.equal(JSON.parse(fs.readFileSync(process.argv[9], "utf8")).notes[0].content,
  "Preserved external note")
assert.equal(JSON.parse(fs.readFileSync(process.argv[10], "utf8")).notes[0].content,
  "Verification mismatch")

const restoreRoot = process.argv[11]
const resetRoot = process.argv[12]
const unsupportedRoot = process.argv[13]
const archiveFailureRoot = process.argv[14]
const conflictRoot = process.argv[15]
const interruptedRoot = process.argv[16]
const handoffRetryRoot = process.argv[17]
const recoveryShutdownRoot = process.argv[18]
const backupChangeRoot = process.argv[19]
const verificationRaceRoot = process.argv[20]
const modeRoot = process.argv[21]
const repeatRoot = process.argv[22]
const writeRetryRoot = process.argv[23]
const helperFailureRoot = process.argv[24]
const inplaceRoot = process.argv[25]
const interruptedInstalledRoot = process.argv[26]
const symlinkPrimaryRoot = process.argv[27]
const symlinkBackupRoot = process.argv[28]
const currentArchivePayload = (root, name) =>
  fs.readFileSync(`${root}/pinote/${name}/notes.json`, "utf8")
const restoreFiles = fs.readdirSync(`${restoreRoot}/pinote`)
const restoreArchives = restoreFiles.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const restoreCurrentArchives = restoreFiles.filter(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(restoreArchives.length, 1)
assert.equal(restoreCurrentArchives.length, 1)
const restoreOriginal = fs.readFileSync(`${restoreRoot}/pinote/${restoreArchives[0]}`, "utf8")
assert.equal(restoreOriginal, fs.readFileSync(`${restoreRoot}/original-primary`, "utf8"))
assert.equal(currentArchivePayload(restoreRoot, restoreCurrentArchives[0]), restoreOriginal)
assert.notEqual(fs.statSync(`${restoreRoot}/pinote/${restoreArchives[0]}`).ino,
  fs.statSync(`${restoreRoot}/pinote/${restoreCurrentArchives[0]}/notes.json`).ino)
assert.equal(JSON.parse(restoreOriginal).notes.length, 2)
assert.equal(fs.existsSync(`${restoreRoot}/pinote/.pinote-recovery-transaction.json`), false)
assert.equal(JSON.parse(fs.readFileSync(`${restoreRoot}/pinote/notes.json`, "utf8")).notes[0].content,
  "Backup recovery note")

const resetFiles = fs.readdirSync(`${resetRoot}/pinote`)
const resetArchives = resetFiles.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const resetCurrentArchives = resetFiles.filter(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(resetArchives.length, 1)
assert.equal(resetCurrentArchives.length, 1)
assert.equal(fs.readFileSync(`${resetRoot}/pinote/${resetArchives[0]}`, "utf8"), "{PINOTE_PRIVATE_SENTINEL_8f92")
assert.equal(currentArchivePayload(resetRoot, resetCurrentArchives[0]),
  "{PINOTE_PRIVATE_SENTINEL_8f92")
assert.equal(fs.existsSync(`${resetRoot}/pinote/.pinote-recovery-transaction.json`), false)
assert.deepEqual(JSON.parse(fs.readFileSync(`${resetRoot}/pinote/notes.json`, "utf8")),
  { version: 1, notes: [] })
assert.equal(JSON.parse(fs.readFileSync(`${resetRoot}/pinote/notes.json.bak`, "utf8")).notes[0].content,
  "PINOTE_PRIVATE_SENTINEL_8f92")
assert.equal(fs.readFileSync(`${unsupportedRoot}/pinote/notes.json`, "utf8"),
  '{"version":1.5,"unknown":"shape"}\n')
assert.equal(fs.readFileSync(`${archiveFailureRoot}/pinote/notes.json`, "utf8"),
  "{archive-must-remain")
assert.equal(fs.readdirSync(`${archiveFailureRoot}/pinote`)
  .filter(name => name.startsWith("notes.json.recovery-")).length, 0)

assert.equal(JSON.parse(fs.readFileSync(`${conflictRoot}/pinote/notes.json`, "utf8")).notes[0].content,
  "External cleanup note")
assert.equal(JSON.parse(fs.readFileSync(`${conflictRoot}/pinote/notes.json.bak`, "utf8")).notes[0].content,
  "Backup handoff note")
const conflictArchives = fs.readdirSync(`${conflictRoot}/pinote`)
  .filter(name => name.startsWith("notes.json.recovery-")
    && !name.startsWith("notes.json.recovery-current-"))
assert.equal(conflictArchives.length, 1)
for (const archive of conflictArchives)
  assert.equal(fs.readFileSync(`${conflictRoot}/pinote/${archive}`, "utf8"), "{conflict-original")

assert.equal(JSON.parse(fs.readFileSync(`${interruptedRoot}/pinote/notes.json`, "utf8")).notes[0].content,
  "Interrupted replacement")
assert.equal(fs.readFileSync(`${interruptedRoot}/pinote/notes.json.recovery-interrupted`, "utf8"),
  "{interrupted-original")
assert.equal(currentArchivePayload(interruptedRoot, "notes.json.recovery-current-interrupted"),
  "{interrupted-original")
assert.equal(fs.existsSync(`${interruptedRoot}/pinote/.pinote-recovery-transaction.json`), false)
assert.equal(fs.existsSync(`${interruptedRoot}/pinote/.pinote-recovery-stage-interrupted`), false)

assert.equal(JSON.parse(fs.readFileSync(`${interruptedInstalledRoot}/pinote/notes.json`, "utf8"))
  .notes[0].content, "Interrupted replacement")
assert.equal(fs.existsSync(`${interruptedInstalledRoot}/pinote/notes.json.bak`), false)
assert.equal(fs.existsSync(`${interruptedInstalledRoot}/pinote/.pinote-recovery-transaction.json`), false)
assert.equal(fs.existsSync(`${interruptedInstalledRoot}/pinote/.pinote-recovery-stage-installed`), false)

assert.equal(JSON.parse(fs.readFileSync(`${inplaceRoot}/pinote/notes.json`, "utf8")).notes[0].content,
  "External in-place note")
const inplaceNames = fs.readdirSync(`${inplaceRoot}/pinote`)
const inplaceExpected = inplaceNames.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
assert.equal(inplaceExpected.length, 1)
assert.equal(fs.readFileSync(`${inplaceRoot}/pinote/${inplaceExpected[0]}`, "utf8"), "{inplace-original")
assert.equal(inplaceNames.some(name => name.startsWith("notes.json.recovery-current-")), false)
assert.equal(inplaceNames.some(name => name.startsWith(".pinote-recovery-")), false)

assert.equal(fs.lstatSync(`${symlinkPrimaryRoot}/pinote/notes.json`).isSymbolicLink(), true)
assert.equal(fs.readFileSync(`${symlinkPrimaryRoot}/external-primary`, "utf8"), "{symlink-primary-target")
assert.equal(fs.statSync(`${symlinkPrimaryRoot}/external-primary`).mode & 0o777, 0o640)
assert.equal(fs.readdirSync(`${symlinkPrimaryRoot}/pinote`)
  .some(name => name.startsWith("notes.json.recovery-")), false)

assert.equal(fs.lstatSync(`${symlinkBackupRoot}/pinote/notes.json.bak`).isSymbolicLink(), true)
assert.equal(JSON.parse(fs.readFileSync(`${symlinkBackupRoot}/external-backup`, "utf8"))
  .notes[0].content, "Symlink backup target")
assert.equal(fs.statSync(`${symlinkBackupRoot}/external-backup`).mode & 0o777, 0o640)
assert.equal(fs.readFileSync(`${symlinkBackupRoot}/pinote/notes.json`, "utf8"),
  "{symlink-backup-primary")

for (const [root, original] of [[handoffRetryRoot, "{handoff-retry-original"]]) {
  const names = fs.readdirSync(`${root}/pinote`)
  const expected = names.filter(name => name.startsWith("notes.json.recovery-")
    && !name.startsWith("notes.json.recovery-current-"))
  const current = names.filter(name => name.startsWith("notes.json.recovery-current-"))
  assert.equal(expected.length, 1)
  assert.equal(current.length, 1)
  assert.equal(fs.readFileSync(`${root}/pinote/${expected[0]}`, "utf8"), original)
  assert.equal(currentArchivePayload(root, current[0]), original)
  assert.deepEqual(JSON.parse(fs.readFileSync(`${root}/pinote/notes.json`, "utf8")),
    { version: 1, notes: [] })
  assert.equal(fs.existsSync(`${root}/pinote/.pinote-recovery-transaction.json`), false)
}

const shutdownNames = fs.readdirSync(`${recoveryShutdownRoot}/pinote`)
const shutdownExpected = shutdownNames.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
assert.equal(shutdownExpected.length, 1)
assert.equal(shutdownNames.filter(name => name.startsWith("notes.json.recovery-current-")).length, 0)
assert.equal(fs.readFileSync(`${recoveryShutdownRoot}/pinote/${shutdownExpected[0]}`, "utf8"),
  "{shutdown-recovery-original")
assert.equal(fs.readFileSync(`${recoveryShutdownRoot}/pinote/notes.json`, "utf8"),
  "{shutdown-recovery-original")
assert.equal(fs.existsSync(`${recoveryShutdownRoot}/pinote/.pinote-recovery-transaction.json`), false)
assert.equal(shutdownNames.some(name => name.startsWith(".pinote-recovery-stage-")), false)

assert.equal(fs.readFileSync(`${backupChangeRoot}/pinote/notes.json`, "utf8"),
  "{backup-change-primary")
assert.equal(JSON.parse(fs.readFileSync(`${backupChangeRoot}/pinote/notes.json.bak`, "utf8"))
  .notes[0].content, "Changed backup note")
assert.equal(fs.readdirSync(`${backupChangeRoot}/pinote`)
  .some(name => name.startsWith("notes.json.recovery-")
    || name.startsWith(".pinote-recovery-")), false)

assert.equal(JSON.parse(fs.readFileSync(`${verificationRaceRoot}/pinote/notes.json`, "utf8"))
  .notes[0].content, "External verification note")
assert.equal(fs.existsSync(`${verificationRaceRoot}/pinote/.pinote-recovery-transaction.json`), false)
const raceNames = fs.readdirSync(`${verificationRaceRoot}/pinote`)
const raceExpected = raceNames.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const raceCurrent = raceNames.filter(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(raceExpected.length, 1)
assert.equal(raceCurrent.length, 1)
assert.equal(fs.readFileSync(`${verificationRaceRoot}/pinote/${raceExpected[0]}`, "utf8"),
  "{verification-race-primary")
assert.equal(currentArchivePayload(verificationRaceRoot, raceCurrent[0]), "{verification-race-primary")
assert.equal(raceNames.some(name => name.startsWith(".pinote-recovery-stage-")), false)

const fileMode = path => fs.statSync(path).mode & 0o777
assert.equal(fileMode(`${verificationRaceRoot}/pinote/${raceExpected[0]}`), 0o600)
assert.equal(fileMode(`${verificationRaceRoot}/pinote/${raceCurrent[0]}`), 0o700)
assert.equal(fileMode(`${verificationRaceRoot}/pinote/${raceCurrent[0]}/notes.json`), 0o644)
assert.equal(fileMode(`${modeRoot}/pinote`), 0o700)
assert.equal(fileMode(`${modeRoot}/pinote/notes.json`), 0o600)
assert.equal(fileMode(`${modeRoot}/pinote/notes.json.bak`), 0o600)
const modeNames = fs.readdirSync(`${modeRoot}/pinote`)
const modeExpected = modeNames.find(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const modeCurrent = modeNames.find(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(fileMode(`${modeRoot}/pinote/${modeExpected}`), 0o600)
assert.equal(fileMode(`${modeRoot}/pinote/${modeCurrent}`), 0o700)
assert.equal(fileMode(`${modeRoot}/pinote/${modeCurrent}/notes.json`), 0o600)

const repeatNames = fs.readdirSync(`${repeatRoot}/pinote`)
const repeatExpected = repeatNames.filter(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const repeatCurrent = repeatNames.filter(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(repeatExpected.length, 2)
assert.equal(repeatCurrent.length, 2)
const repeatPayloads = repeatExpected.map(name => fs.readFileSync(`${repeatRoot}/pinote/${name}`, "utf8")).sort()
assert.deepEqual(repeatPayloads, ["{first-damaged-primary", "{second-damaged-primary"].sort())
assert.deepEqual(repeatCurrent.map(name => currentArchivePayload(repeatRoot, name)).sort(), repeatPayloads)
assert.equal(repeatNames.some(name => name.startsWith(".pinote-recovery-")), false)

const retryNames = fs.readdirSync(`${writeRetryRoot}/pinote`)
const retryExpected = retryNames.find(name => name.startsWith("notes.json.recovery-")
  && !name.startsWith("notes.json.recovery-current-"))
const retryCurrent = retryNames.find(name => name.startsWith("notes.json.recovery-current-"))
assert.equal(fs.readFileSync(`${writeRetryRoot}/pinote/${retryExpected}`, "utf8"), "{write-retry-original")
assert.equal(currentArchivePayload(writeRetryRoot, retryCurrent), "{write-retry-original")
assert.equal(JSON.parse(fs.readFileSync(`${writeRetryRoot}/pinote/notes.json.bak`, "utf8"))
  .notes[0].content, "Write retry backup")
assert.equal(retryNames.some(name => name.startsWith(".pinote-recovery-")), false)

const helperNames = fs.readdirSync(`${helperFailureRoot}/pinote`)
assert.equal(fs.readFileSync(`${helperFailureRoot}/pinote/notes.json`, "utf8"), "{helper-failure-primary")
assert.equal(helperNames.some(name => name.startsWith("notes.json.recovery-")
  || name.startsWith(".pinote-recovery-")), false)
NODE

printf 'Pinote store smoke test passed.\n'

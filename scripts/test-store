RETRY_HOOK="$RECOVERY_HANDOFF_RETRY_ROOT/handoff"
(
  for _ in {1..500}; do [[ -e $RETRY_HOOK.ready ]] && break; sleep 0.01; done
  [[ -e $RETRY_HOOK.ready ]] || exit 1
  : > "$RETRY_HOOK.fail-after-move"
  : > "$RETRY_HOOK.continue"
  for _ in {1..500}; do [[ -e $RETRY_HOOK.moved ]] && break; sleep 0.01; done
  [[ -e $RETRY_HOOK.moved ]] || exit 1
) &
RETRY_HOOK_PID=$!
export PINOTE_RECOVERY_HANDOFF_HOOK=$RETRY_HOOK
